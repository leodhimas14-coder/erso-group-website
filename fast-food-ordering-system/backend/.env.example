# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas or self-hosted). Swap for Firebase config if that
# backend is chosen instead - see src/config/firebase.js
MONGODB_URI=mongodb://localhost:27017/erso_fastfood

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Albanian fiscalization (fature.al)
FATURE_AL_API_URL=https://api.fature.al
FATURE_AL_API_KEY=change-me
FATURE_AL_BUSINESS_NIPT=change-me

# Firebase (optional real-time / alt-DB path)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
