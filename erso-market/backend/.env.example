PORT=4000
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/erso-market
JWT_SECRET=ndryshoje-me-nje-tekst-te-gjate-dhe-te-rastesishem
# Adresa(t) e frontend-it, të ndara me presje
CLIENT_ORIGIN=http://localhost:5173

# Vlerat fillestare. Pasi i ndryshon te Admin → Cilësimet, vlejnë ato të panelit.
SHIPPING_FEE=300
FREE_SHIPPING_FROM=6000
CNY_TO_ALL=13

# Pagesa me kartë: "test" = faqe prove (vetëm për zhvillim), "none" = e fikur.
# Në prodhim "test" çaktivizohet vetë. Ofruesi i vërtetë shtohet te
# src/services/payment.service.js kur të kesh llogarinë e tregtarit.
PAYMENT_PROVIDER=test

# Fotot dhe videot që ngarkon nga paneli.
# Online rekomandohet Cloudinary (falas deri në një kufi): kopjo "API environment variable"
# nga paneli i Cloudinary, p.sh. cloudinary://KEY:SECRET@EMRI
CLOUDINARY_URL=
# Pa Cloudinary, skedarët ruhen në disk (mirë për VPS, jo për Render/Railway).
UPLOAD_DIR=./uploads
# Adresa publike e këtij serveri, për linket e fotove (p.sh. https://api.ersomarket.al)
PUBLIC_API_URL=

# Njoftim në Telegram për çdo porosi të re (opsionale)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Për `npm run seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
